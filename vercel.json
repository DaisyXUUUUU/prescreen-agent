{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "includeFiles": "{src,app,trials,data/extended_cases,cache/rxnav}/**"
    }
  },
  "rewrites": [
    {
      "source": "/report",
      "destination": "/docs/demo/index.html"
    },
    {
      "source": "/guide",
      "destination": "/docs/guide/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    }
  ]
}
