                "unit": "day",
                "minimum_inclusive": true
              },
              "require_complete_interval": true,
              "interruption_and_dose_change_policy": "pending_review"
            },
            "otherwise": {
              "op": "review_required",
              "review_key": "statin_exception_per_protocol",
              "default": "unknown"
            }
          },
          {
            "op": "if_used",
            "concept_set": "bempedoic_acid",
            "input": {
              "field": "medication_exposures"
            },
            "then": {
              "op": "and",
              "args": [
                {
                  "op": "stable_dose",
                  "concept_set": "bempedoic_acid",
                  "input": {
                    "field": "medication_exposures"
                  },
                  "anchor": {
                    "field": "context.screening_visit_1_at"
                  },
                  "duration": {
                    "value": 28,
                    "unit": "day",
                    "minimum_inclusive": true
                  },
                  "require_complete_interval": true,
                  "interruption_and_dose_change_policy": "pending_review"
                },
                {
                  "op": "review_required",
                  "review_key": "local_prescribing_guidance",
                  "default": "unknown"
                }
              ]
            }
          },
          {
            "op": "if_used",
            "concept_set": "ezetimibe",
            "input": {
              "field": "medication_exposures"
            },
            "then": {
              "op": "and",
              "args": [
                {
                  "op": "stable_dose",
                  "concept_set": "ezetimibe",
                  "input": {
                    "field": "medication_exposures"
                  },
                  "anchor": {
                    "field": "context.screening_visit_1_at"
                  },
                  "duration": {
                    "value": 28,
                    "unit": "day",
