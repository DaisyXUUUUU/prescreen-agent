            },
            "require_evidence": true
          },
          {
            "op": "review_required",
            "review_key": "LDL_goal_and_failure_per_investigator_local_guidance",
            "default": "unknown"
          },
          {
            "op": "conditional",
            "condition": {
              "op": "review_required",
              "review_key": "statin_tolerated_and_not_contraindicated",
              "default": "unknown"
            },
            "then": {
              "op": "stable_dose",
              "concept_set": "statins",
              "input": {
