# Copy to .env and fill in. Never commit .env.
# Credentials come from your local AWS profile (aws configure / aws sso login), not this file.
AWS_PROFILE=default
AWS_REGION=us-west-2

# Bedrock model or inference-profile ID with model access enabled in AWS_REGION.
# Team default: Amazon Nova 2 Lite via the US cross-region inference profile.
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# S3 bucket for snapshots/, logs/, cache/
S3_BUCKET=prescreen-hack-CHANGEME
